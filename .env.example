# Default: placeholder contacts disabled. Explicitly opt in only for preview.
NEXT_PUBLIC_CONTACT_PREVIEW=false

# TODO: Set only after the canonical deployment origin is approved (HTTPS).
NEXT_PUBLIC_SITE_URL=

# Default: noindex, even during a production build. Set true ONLY for the
# approved live deployment, with a valid HTTPS origin above (no path/query/hash).
# Keep false on every preview deployment; CONTACT_PREVIEW=true also forces noindex.
# Rebuild after changing these flags. Use deployment access controls for private previews.
NEXT_PUBLIC_SITE_INDEXABLE=false
